            <column caption='{SUM([CY Profit])}' datatype='real' name='[Calculation_0166623986913282]' role='measure' type='quantitative' user:unnamed='KPI Profits'>
              <calculation class='tableau' formula='{SUM([Calculation_0636871345020929])}' />
